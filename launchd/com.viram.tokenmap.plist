<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.viram.tokenmap</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/ad1225/Documents/viram/tokenmap-action/scripts/run.sh</string>
    </array>

    <!-- Daily at 09:00 local. If the Mac was asleep or off at that time,
         launchd runs the job once shortly after it wakes. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/tokenmap-action.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/tokenmap-action.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
